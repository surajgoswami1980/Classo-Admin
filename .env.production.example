# ─── Laravel Admin — production template (AWS Lightsail / VPS) ───────
# Copy to `.env` on the server and fill in real values. NEVER commit the real .env.
# php artisan key:generate   (sets APP_KEY)

APP_NAME="MyClasses"
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://admin.myclasses.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ─── Shared database (SAME as the NestJS API) ───────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_erp_admin
DB_USERNAME=erp_user
DB_PASSWORD=CHANGE_ME_db_password

BROADCAST_CONNECTION=log
# Use Redis for cache/sessions/queue in production (faster than database driver)
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
# IMPORTANT: the API's push worker pulls from the raw Redis key
# "queue:push_notifications". Keep Laravel's queue on Redis but note the API
# worker reads its own key, so there is no conflict.

FILESYSTEM_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# NestJS API (same server, HTTPS)
NESTJS_API_BASE_URL=https://api.yourdomain.com/api
NESTJS_API_KEY=
NESTJS_API_TIMEOUT=30

SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password

TENANT_IDENTIFICATION=session
DEFAULT_SCHOOL_ID=

FILAMENT_FILESYSTEM_DISK=public

# Only your real domains (comma separated, no spaces)
SANCTUM_STATEFUL_DOMAINS=admin.yourdomain.com

# ─── Do NOT set in production ───────────────────────────────────────
# SUPER_OTP   -> leave unset (master OTP is a security hole)
# OTP_DEV_ECHO=false

SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SCHERP

# MUST be IDENTICAL to the NestJS API's SETTINGS_ENCRYPTION_KEY.
# Generate once:  php -r "echo base64_encode(random_bytes(32)).PHP_EOL;"
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_same_as_api
